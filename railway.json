schema:
  properties:
    NODE_ENV:
      description: Node environment
      type: string
      enum:
        - production
        - development
        - test
      default: production

    PORT:
      description: Port the server listens on
      type: number
      default: 3000

    DATABASE_URL:
      description: PostgreSQL database URL
      type: string

    DIRECT_URL:
      description: Direct PostgreSQL connection URL (bypass pooler if using one)
      type: string

    JWT_SECRET:
      description: JWT secret key (min 32 characters)
      type: string

    STRAVA_CLIENT_ID:
      description: Strava OAuth2 Client ID
      type: string

    STRAVA_CLIENT_SECRET:
      description: Strava OAuth2 Client Secret
      type: string

    STRAVA_REDIRECT_URI:
      description: Strava OAuth2 Redirect URI
      type: string

    R2_ENDPOINT:
      description: Cloudflare R2 endpoint URL
      type: string

    R2_ACCESS_KEY_ID:
      description: Cloudflare R2 access key ID
      type: string

    R2_SECRET_ACCESS_KEY:
      description: Cloudflare R2 secret access key
      type: string

    R2_BUCKET_NAME:
      description: Cloudflare R2 bucket name
      type: string

    SENTRY_DSN:
      description: Sentry error tracking DSN
      type: string

    SENTRY_ENVIRONMENT:
      description: Sentry environment
      type: string
      enum:
        - production
        - staging
        - development
      default: production

    POSTHOG_API_KEY:
      description: PostHog analytics API key
      type: string

    FRONTEND_URL:
      description: Frontend URL for CORS
      type: string
